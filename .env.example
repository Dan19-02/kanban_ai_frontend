# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Environment: development | production | test
NODE_ENV="development"

# Port the server listens on.
PORT="3000"

# --- Database (PostgreSQL) ---------------------------------------------------
# Connection string. The default matches the bundled docker-compose.yml.
# For a hosted database (Neon, Supabase, RDS, etc.) paste its connection URL.
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# --- Auth --------------------------------------------------------------------
# Secret used to sign session JWTs. MUST be long and random in production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- AI ----------------------------------------------------------------------
# NVIDIA API key for MiniMax M3 (https://build.nvidia.com/).
# Leave blank to run the app without AI transcript analysis.
NVIDIA_API_KEY=""

# --- Deployment --------------------------------------------------------------
# Public URL of the app. Used to build share links, Stripe redirect URLs, and to
# lock down CORS in production. Optional in development (defaults to same-origin).
# APP_URL="https://your-domain.com"

# --- Billing (Stripe) --------------------------------------------------------
# Leave STRIPE_SECRET_KEY blank to run without payments. The free tier (3
# lifetime transcriptions) is still enforced; paid upgrades are simply disabled.
#
# Setup:
#   1. Create a Stripe account and switch to Test mode.
#   2. Create 3 recurring (monthly) Products/Prices and copy their price IDs:
#        Starter   $10/mo  -> STRIPE_PRICE_STARTER
#        Pro       $30/mo  -> STRIPE_PRICE_PRO
#        Unlimited $99/mo  -> STRIPE_PRICE_UNLIMITED
#   3. Add a webhook endpoint at  {APP_URL}/api/billing/webhook  subscribed to
#      checkout.session.completed and customer.subscription.* events, then copy
#      its signing secret into STRIPE_WEBHOOK_SECRET.
#      Locally:  stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_UNLIMITED=""
