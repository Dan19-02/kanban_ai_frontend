# ─── Frontend environment (no secrets) ──────────────────────────────────────
# This is a static React/Vite app. It holds NO secrets — anything defined here
# is bundled into the public client. The only configuration is where to find
# the backend API.
#
#   cp .env.example .env

# Origin of the deployed backend API. Read at BUILD time by Vite and inlined
# into the bundle, so it must be set for the production static-site build.
# Leave it UNSET for local development: `npm run dev` proxies /api and
# /socket.io to BACKEND_URL below, so the app talks to a same-origin /api.
# VITE_API_URL="https://kanban-ai-backend.onrender.com"

# Dev-only: where `npm run dev` proxies API/WebSocket traffic. Defaults to
# http://localhost:3000 (the backend's default port). Not used in production.
# BACKEND_URL="http://localhost:3000"
